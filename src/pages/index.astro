---
import { site } from "../data/site";
import { Image } from "astro:assets";
import Icon from "../components/Icon.astro";
import "../styles/global.css";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "PodcastSeries",
  name: site.name,
  description: site.description,
  url: site.canonicalUrl,
  inLanguage: site.language,
  image: new URL(site.assets.ogImage, site.canonicalUrl).toString(),
  author: { "@type": "Person", name: "Petr Sečkář" }
};
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={site.canonicalUrl} />
    <link rel="icon" href={site.assets.favicon} type="image/png" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={site.rss.url} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={site.canonicalUrl} />
    <meta property="og:image" content={new URL(site.assets.ogImage, site.canonicalUrl).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={new URL(site.assets.ogImage, site.canonicalUrl).toString()} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      // Apply before first paint; storage is optional (e.g. private browsing).
      try {
        const preference = localStorage.getItem("lzk-theme");
        if (preference === "light" || preference === "dark") {
          document.documentElement.dataset.theme = preference;
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#obsah">Přeskočit na obsah</a>
    <header class="site-header wrap">
      <a class="brand" href="#" aria-label="Lidi za kódem – domů">
        <img src={site.assets.logo} alt="" width="48" height="48" />
        <span>Lidi za kódem</span>
      </a>
      <nav class="main-nav" aria-label="Hlavní navigace">
        <a href="#poslouchat">Poslouchat</a>
        <a href="#o-podcastu">O podcastu</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
      <div class="theme-switch" role="group" aria-label="Vzhled stránky" hidden>
        <button type="button" data-theme-choice="light" aria-label="Světlý vzhled" aria-pressed="false" title="Světlý vzhled"><Icon name="sun" /></button>
        <button type="button" data-theme-choice="dark" aria-label="Tmavý vzhled" aria-pressed="false" title="Tmavý vzhled"><Icon name="moon" /></button>
        <button type="button" data-theme-choice="system" aria-label="Podle systému" aria-pressed="true" title="Podle systému"><Icon name="monitor" /></button>
      </div>
    </header>

    <main id="obsah">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">Kuchyňkový pokec<br />o práci, životě<br />a <span class="headline-accent">tvorbě software</span></h1>
          <p class="hero-subtitle">{site.subtitle} {site.publishingNote.slice(0, -site.publishingHighlight.length)}<span class="publishing-note">{site.publishingHighlight}</span></p>
        </div>
        <div class="hero-art">
          <div class="cover-frame"><img src={site.assets.logo} alt="Logo podcastu Lidi za kódem" width="3000" height="3000" fetchpriority="high" /></div>
          <span class="cover-note">Podcast</span>
        </div>
      </section>

      <section class="listening wrap" id="poslouchat" aria-label="Poslouchej Lidi za kódem">
        <article class="episode-card" data-episode-card data-feed-url={site.rss.url} aria-labelledby="episode-title">
          <div class="episode-card-top">
            <p class="eyebrow">Nejnovější epizoda</p>
            <Icon name="headphones" />
          </div>
          <div class="episode-main">
            <img class="episode-art" data-episode-art src={site.assets.logo} alt="" width="144" height="144" />
            <div class="episode-heading">
              <p class="episode-meta" data-episode-meta>Rozhovory s lidmi za kódem</p>
              <h2 id="episode-title" data-episode-title>Další pokec už na tebe čeká.</h2>
            </div>
          </div>
          <p class="episode-description" data-episode-description>O práci, životě a všem mezi tím. Pusť si nejnovější rozhovor tady nebo ve své oblíbené aplikaci.</p>
          <div class="episode-player" data-episode-player hidden>
            <audio controls preload="none" aria-label="Přehrát nejnovější epizodu" data-latest-audio></audio>
          </div>
          <div class="episode-bottom">
            <p class="feed-status" data-feed-status role="status" aria-live="polite"></p>
            <button class="retry-button" type="button" data-feed-retry hidden>Zkusit znovu <Icon name="refresh" /></button>
            <a class="episode-link" data-episode-link href={site.listenLinks[0].href} target="_blank" rel="noopener noreferrer">Otevřít na Spotify <Icon name="arrow" /></a>
          </div>
          <noscript><p class="feed-status">Nejnovější epizodu najdeš na Spotify a dalších platformách. Přehrávač na webu potřebuje JavaScript.</p></noscript>
        </article>

        <aside class="platforms" aria-labelledby="platform-title">
          <h2 id="platform-title">Kde poslouchat</h2>
          <div class="platform-grid">
            {site.listenLinks.map((platform) => (
              <a class="platform-link" href={platform.href} target="_blank" rel="noopener noreferrer">
                <img src={platform.icon} alt="" width="25" height="25" />
                <span>{platform.label}</span><Icon name="arrow" />
              </a>
            ))}
            <button class="platform-link platform-link--rss" type="button" data-rss-copy data-rss-url={site.rss.url} data-tooltip="Zkopírovat RSS odkaz" aria-label="Zkopírovat RSS odkaz" hidden>
              <img src={site.rss.icon} alt="" width="25" height="25" />
              <span>RSS feed</span><Icon name="copy" />
            </button>
            <noscript><a class="platform-link" href={site.rss.url} target="_blank" rel="noopener noreferrer"><img src={site.rss.icon} alt="" width="25" height="25" /><span>RSS feed</span><Icon name="arrow" /></a></noscript>
          </div>
          <p class="sr-only" data-copy-status role="status" aria-live="polite"></p>
        </aside>
      </section>

      <section class="about-section wrap" id="o-podcastu" aria-labelledby="about-title">
        <div class="section-label"><h2 id="about-title">O podcastu</h2></div>
        <div class="section-copy">
          {site.about.body.map((paragraph) => <p>{paragraph}</p>)}
          <details class="intro-player">
            <summary><span class="intro-play-icon"><Icon name="play" /></span><span>Pusť si intro<span class="intro-caption">Jak to celé začalo · 1 minuta</span></span><Icon name="plus" /></summary>
            <div class="intro-player-content">
              <audio controls preload="none" aria-label="Intro podcastu Lidi za kódem" src={site.intro.audioUrl} data-intro-audio></audio>
              <a class="text-link" href={site.intro.url} target="_blank" rel="noopener noreferrer">Otevřít intro na Spotify <Icon name="arrow" /></a>
            </div>
          </details>
        </div>
      </section>

      <section class="author-section wrap" id="o-autorovi" aria-labelledby="author-title">
        <div class="section-label"><h2 id="author-title">O autorovi</h2></div>
        <div class="author-profile">
          <Image class="author-photo" src={site.author.photo} alt="Petr Sečkář u mikrofonu" widths={[320, 640, site.author.photo.width]} sizes="(max-width: 359px) calc(100vw - 40px), (max-width: 760px) 320px, (max-width: 1050px) 300px, 260px" format="webp" quality={80} loading="lazy" decoding="async" />
          <div class="section-copy">
            <div class="author-heading"><h3>{site.author.name.split(" - ")[0]}<span>{site.author.name.split(" - ")[1]}</span></h3></div>
            {site.author.bio.map((paragraph) => <p>{paragraph}</p>)}
            <div class="author-links">{site.author.socialLinks.map((link) => (
              <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer"><img src={link.icon} alt="" width="19" height="19" /> Potkáme se na {link.label}u <Icon name="arrow" /></a>
            ))}</div>
          </div>
        </div>
      </section>

      <section class="contact-section wrap" id="kontakt" aria-labelledby="contact-title">
        <div class="contact-panel">
          <div><h2 id="contact-title">Máš zájem přijít jako host?</h2><p>Nebo máš otázku, zpětnou vazbu, téma, které bys rád slyšel? Či ti tento podcast chybí na tvé oblíbené podcastové platformě? Napiš mi na mail. Nebo na LinkedIn.</p></div>
          <a class="contact-link" href={`mailto:${site.email}`}>{site.email}<Icon name="arrow" /></a>
        </div>
      </section>
    </main>

    <footer class="site-footer wrap"><a class="footer-brand" href="#">Lidi za kódem</a><a class="text-link" href="#poslouchat">Zpátky k poslechu <Icon name="up" /></a></footer>
    <script src="../scripts/page.ts"></script>
  </body>
</html>
