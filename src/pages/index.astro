---
import { site } from "../data/site";

const mailtoHref = `mailto:${site.email}`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "PodcastSeries",
  name: site.name,
  description: site.description,
  url: site.canonicalUrl,
  inLanguage: site.language,
  image: new URL(site.assets.ogImage, site.canonicalUrl).toString(),
  author: {
    "@type": "Person",
    name: site.author.name
  }
};
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={site.canonicalUrl} />
    <link rel="icon" href={site.assets.favicon} type="image/png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={site.canonicalUrl} />
    <meta property="og:image" content={new URL(site.assets.ogImage, site.canonicalUrl).toString()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={new URL(site.assets.ogImage, site.canonicalUrl).toString()} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <main>
      <section class="intro" id="zacatek" aria-labelledby="hero-title">
        <div class="intro__inner">
          <div class="hero-logo-block">
            <h1 id="hero-title" class="sr-only">{site.name}</h1>
            <a class="hero-logo" href={site.canonicalUrl} aria-label="Lidi za kódem domů">
              <img src={site.assets.logo} alt={site.name} width="3000" height="3000" />
            </a>
          </div>

          <section class="listen" aria-labelledby="listen-title">
            <div class="section-heading">
              <h2 id="listen-title">Kde poslouchat</h2>
            </div>

            <div class="platform-grid">
              {
                site.listenLinks.map((platform) => (
                  <a class="platform-link" href={platform.href} target="_blank" rel="noopener noreferrer">
                    <span class="platform-link__icon" aria-hidden="true">
                      <img src={platform.icon} alt="" width="28" height="28" loading="lazy" />
                    </span>
                    <span class="platform-link__label">{platform.label}</span>
                  </a>
                ))
              }
              <button
                class="platform-link platform-link--rss"
                type="button"
                data-rss-copy
                data-rss-url={site.rss.url}
                data-tooltip="Zkopírovat RSS odkaz"
                aria-label="Zkopírovat RSS odkaz"
              >
                <span class="platform-link__icon" aria-hidden="true">
                  <img src={site.rss.icon} alt="" width="28" height="28" loading="lazy" />
                </span>
                <span class="platform-link__label">{site.rss.label}</span>
                <img class="copy-icon" src="/icons/copy.svg" alt="" width="20" height="20" aria-hidden="true" />
              </button>
            </div>
          </section>

          <div class="hero-text">
            <p class="claim hero-claim">{site.claim}</p>
            <p class="claim publishing-note">{site.publishingNote}</p>
          </div>
          <a class="hero-more" href="#o-podcastu">
            <span>Chci vědět víc</span>
            <span class="hero-more__arrow" aria-hidden="true">↓</span>
          </a>
        </div>
      </section>

      <section class="content-section" id="o-podcastu" aria-labelledby="about-title">
        <div class="content-grid">
          <div class="section-heading">
            <h2 id="about-title">O podcastu</h2>
          </div>
          <div class="copy">
            <p class="lead">{site.about.lead}</p>
            <p>{site.about.body}</p>
            <p class="lead">Pusť si intro:</p>
            <div class="spotify-embed">
              <iframe
                src="https://creators.spotify.com/pod/profile/lidizakodem/embed/episodes/0-Intro-podcastu-Lidi-za-kdem-e3jo8c3/a-aclul4s"
                title="Intro podcastu Lidi za kódem na Spotify"
                height="102"
                loading="lazy"
                scrolling="no"
              ></iframe>
            </div>
          </div>
        </div>
      </section>

      <section class="content-section content-section--soft" aria-labelledby="author-title">
        <div class="content-grid">
          <div class="section-heading">
            <h2 id="author-title">O autorovi</h2>
          </div>
          <div class="copy">
            <p class="lead">{site.author.name}</p>
            <p>{site.author.bio}</p>
            <div class="inline-links" aria-label="Sociální sítě">
              {
                site.author.socialLinks.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {"icon" in link && <img src={link.icon} alt="" width="20" height="20" loading="lazy" />}
                    <span>{link.label}</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="contact" aria-labelledby="contact-title">
        <div class="contact__inner">
          <div>
            <h2 id="contact-title">Kontakt</h2>
            <p class="lead">Máš zájem přijít jako host?</p>
            <p>Nebo máš otázku, zpětnou vazbu, téma, které bys rád slyšel? Či ti tento podcast chybí na tvé oblíbené podcastové platformě? Napiš mi na mail. Nebo na LinkedIn.</p>
          </div>
          <a class="contact-link" href={mailtoHref}>{site.email}</a>
        </div>
      </section>
    </main>

    <a class="floating-listen" href="#zacatek" data-floating-listen>
      <span class="floating-listen__arrow" aria-hidden="true">↑</span>
      <span>
      Začít poslouchat<br/>
      LIDI ZA KÓDEM
      </span>
    </a>

    <script>
      const rssButton = document.querySelector("[data-rss-copy]");
      const floatingListen = document.querySelector("[data-floating-listen]");
      const aboutSection = document.querySelector("#o-podcastu");

      async function copyText(value) {
        if (navigator.clipboard && window.isSecureContext) {
          try {
            await navigator.clipboard.writeText(value);
            return;
          } catch {
            // Fallback below handles browsers or contexts where clipboard permission is denied.
          }
        }

        const textarea = document.createElement("textarea");
        textarea.value = value;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.left = "-9999px";
        document.body.append(textarea);
        textarea.select();
        document.execCommand("copy");
        textarea.remove();
      }

      rssButton?.addEventListener("click", async () => {
        const rssUrl = rssButton.getAttribute("data-rss-url");
        if (!rssUrl) return;

        try {
          await copyText(rssUrl);
          rssButton.setAttribute("data-tooltip", "RSS odkaz zkopírován");
          rssButton.setAttribute("data-copied", "true");
        } catch {
          rssButton.setAttribute("data-tooltip", "RSS odkaz se nepodařilo zkopírovat");

        }

        window.setTimeout(() => {
          rssButton.setAttribute("data-tooltip", "Zkopírovat RSS odkaz");
          rssButton.removeAttribute("data-copied");
        }, 2200);
      });

      function updateFloatingListen() {
        if (!floatingListen || !aboutSection) return;
        const showAt = aboutSection.offsetTop - 80;
        floatingListen.toggleAttribute("data-visible", window.scrollY >= showAt);
      }

      updateFloatingListen();
      window.addEventListener("scroll", updateFloatingListen, { passive: true });
      window.addEventListener("resize", updateFloatingListen);
    </script>
  </body>
</html>

<style>
  :root {
    --color-bg: #edf6f4;
    --color-bg-muted: #d4ebe8;
    --color-text: #101816;
    --color-muted: #47645f;
    --color-primary: #006874;
    --color-primary-dark: #00464e;
    --color-primary-soft: #d5eeee;
    --color-secondary: #ff7b10;
    --color-secondary-dark: #b84e00;
    --color-secondary-soft: #ffdfbd;
    --color-card: #ffffff;
    --color-line: #b4d8d7;
    --shadow-soft: 0 20px 54px rgba(0, 70, 78, 0.16);
    --radius: 8px;
    --content-width: 1120px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--color-bg);
    color: var(--color-text);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    scroll-behavior: smooth;
  }

  body {
    width: 100%;
    max-width: 100%;
    margin: 0;
    overflow-x: hidden;
    background: var(--color-bg);
  }

  main {
    overflow-x: hidden;
  }

  @supports (overflow: clip) {
    html,
    body,
    main {
      overflow-x: clip;
    }
  }

  body::before {
    content: none;
  }

  a {
    color: inherit;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 3px solid var(--color-secondary);
    outline-offset: 4px;
  }

  button {
    font: inherit;
  }

  img {
    max-width: 100%;
    display: block;
  }

  .sr-only {
    width: 1px;
    height: 1px;
    position: absolute;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .intro {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 1.25rem;
  }

  .intro__inner {
    width: min(100%, var(--content-width));
    min-width: 0;
    margin: 0 auto;
    display: grid;
    gap: 1.4rem;
  }

  .hero-logo-block,
  .listen {
    position: relative;
    min-width: 0;
  }

  .hero-logo-block {
    display: grid;
    justify-items: center;
  }

  .hero-logo {
    width: min(100%, 22rem);
    display: block;
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
  }

  .hero-logo img {
    width: 100%;
    height: auto;
    border-radius: inherit;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h2 {
    margin-bottom: 0;
    color: var(--color-primary);
    font-size: 1.9rem;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: 0;
    overflow-wrap: anywhere;
    text-transform: uppercase;
  }

  .listen h2 {
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .claim {
    max-width: 38rem;
    margin-bottom: 0;
    color: var(--color-secondary-dark);
    font-size: 1.35rem;
    font-weight: 900;
    line-height: 1.22;
    overflow-wrap: anywhere;
  }

  .copy p,
  .contact p {
    color: var(--color-muted);
    font-size: 1.03rem;
    line-height: 1.7;
  }

  .listen {
    display: grid;
    gap: 1rem;
    align-content: center;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.84);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(10px);
  }

  .section-heading {
    min-width: 0;
    display: grid;
    gap: 0.45rem;
    text-align: center;
  }

  .content-section .section-heading {
    text-align: center;
  }

  .listen .section-heading {
    margin-bottom: 0.35rem;
  }

  .platform-grid {
    min-width: 0;
    display: grid;
    gap: 0.65rem;
  }

  .platform-link {
    width: 100%;
    min-width: 0;
    min-height: 4.15rem;
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem;
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-text);
    font-weight: 900;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .platform-link:hover {
    background: #fffaf3;
    border-color: var(--color-secondary);
    box-shadow: 0 12px 24px rgba(8, 62, 56, 0.12);
    transform: translateY(-2px);
  }

  .platform-link--rss:hover::after,
  .platform-link--rss:focus-visible::after {
    position: absolute;
    right: 0.65rem;
    bottom: calc(100% + 0.5rem);
    z-index: 2;
    width: max-content;
    max-width: min(14rem, 70vw);
    padding: 0.45rem 0.6rem;
    background: var(--color-primary-dark);
    border-radius: 6px;
    color: #ffffff;
    content: attr(data-tooltip);
    font-size: 0.8rem;
    font-weight: 800;
    line-height: 1.3;
    text-align: center;
  }

  .platform-link--rss[data-copied="true"] {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .platform-link__icon {
    width: 2.75rem;
    height: 2.75rem;
    display: inline-grid;
    flex: 0 0 auto;
    place-items: center;
  }

  .platform-link__icon img {
    width: 1.65rem;
    height: 1.65rem;
  }

  .platform-link__label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .copy-icon {
    width: 1.1rem;
    height: 1.1rem;
    margin-left: auto;
    opacity: 0.72;
  }

  .copy-status {
    position: absolute;
    right: 1rem;
    bottom: 0.55rem;
    left: 1rem;
    min-height: 1rem;
    margin: 0;
    color: var(--color-primary-dark);
    font-size: 0.86rem;
    font-weight: 800;
  }

  .publishing-note {
    margin: 0;
  }

  .publishing-note::before {
    content: none;
  }

  .hero-more {
    width: fit-content;
    max-width: 100%;
    min-width: 11rem;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    justify-self: center;
    gap: 0.25rem;
    padding: 0.82rem 1.25rem 0.62rem;
    background: var(--color-primary);
    border: 1px solid rgba(0, 70, 78, 0.16);
    border-radius: var(--radius);
    color: #ffffff;
    box-shadow: 0 16px 30px rgba(0, 70, 78, 0.2);
    font-size: 0.95rem;
    font-weight: 900;
    line-height: 1.1;
    text-align: center;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .hero-more:hover {
    background: var(--color-primary-dark);
    box-shadow: 0 18px 34px rgba(0, 70, 78, 0.24);
    transform: translateY(2px);
  }

  .hero-more__arrow {
    color: #ffffff;
    font-size: 1.35rem;
    font-weight: 900;
    line-height: 1;
    text-shadow: 0 0 0 #ffffff;
  }

  .floating-listen {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: 10;
    display: inline-flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: center;
    justify-content: center;
    min-height: 4rem;
    max-width: calc(100vw - 2rem);
    padding: 0.65rem 1rem 0.75rem;
    background: var(--color-primary);
    border-radius: var(--radius);
    color: #ffffff;
    box-shadow: 0 14px 28px rgba(0, 70, 78, 0.22);
    font-size: 0.95rem;
    font-weight: 900;
    text-align: center;
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.6rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      background-color 160ms ease;
  }

  .floating-listen[data-visible] {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .floating-listen:hover {
    background: var(--color-primary-dark);
  }

  .floating-listen__arrow {
    color: #ffffff;
    font-size: 1.3rem;
    font-weight: 900;
    line-height: 1;
    text-shadow: 0 0 0 #ffffff;
  }

  .content-section,
  .contact {
    padding: 4rem 1.25rem;
  }

  .content-section--soft {
    background: rgba(255, 255, 255, 0.46);
    border-block: 1px solid var(--color-line);
  }

  .content-grid,
  .contact__inner {
    width: min(100%, var(--content-width));
    min-width: 0;
    margin: 0 auto;
    display: grid;
    gap: 1.5rem;
  }

  .copy {
    max-width: 48rem;
    min-width: 0;
    margin-inline: auto;
    text-align: center;
  }

  .copy p {
    margin-bottom: 1rem;
  }

  .copy p:last-child {
    margin-bottom: 0;
  }

  .spotify-embed {
    width: min(100%, 28rem);
    min-width: 0;
    margin: 1rem auto 0;
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.84);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: 0 14px 34px rgba(0, 70, 78, 0.12);
  }

  .spotify-embed iframe {
    width: 100%;
    min-width: 0;
    height: 102px;
    display: block;
    border: 0;
    border-radius: 6px;
  }

  .lead {
    color: var(--color-text) !important;
    font-size: 1.17rem !important;
    font-weight: 800;
    line-height: 1.55 !important;
  }

  .inline-links {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1rem;
  }

  .inline-links a,
  .contact-link {
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.8rem;
    padding: 0.7rem 1rem;
    border-radius: var(--radius);
    font-weight: 900;
    text-decoration: none;
  }

  .inline-links a {
    gap: 0.5rem;
    background: var(--color-card);
    border: 1px solid var(--color-line);
    color: var(--color-primary-dark);
  }

  .inline-links img {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 4px;
  }

  .inline-links a:hover {
    border-color: var(--color-secondary);
  }

  .contact {
    background: var(--color-primary-soft);
    color: var(--color-text);
  }

  .contact h2 {
    color: var(--color-primary);
  }

  .contact .lead {
    color: var(--color-text) !important;
  }

  .contact p {
    max-width: 40rem;
    margin-bottom: 0;
    color: var(--color-muted);
  }

  .contact .lead {
    margin: 1rem 0 0.35rem;
  }

  .contact-link {
    width: fit-content;
    overflow-wrap: anywhere;
    background: var(--color-secondary);
    color: #1a120c;
    box-shadow: 0 16px 30px rgba(255, 123, 16, 0.24);
  }

  .contact-link:hover {
    background: #ff9c3f;
  }

  @media (min-width: 720px) {
    .intro {
      padding: 2rem;
    }

    .intro__inner {
      grid-template-columns: minmax(0, 23.5rem) minmax(0, 23.5rem);
      grid-template-areas:
        "logo listen"
        "text text"
        "more more";
      align-items: start;
      justify-content: center;
      gap: 2rem;
    }

    .hero-logo-block {
      grid-area: logo;
    }

    .listen {
      grid-area: listen;
      aspect-ratio: 1;
    }

    .hero-text {
      grid-area: text;
      min-width: 0;
      display: grid;
      gap: 0.35rem;
      text-align: center;
      justify-self: center;
      margin-inline: auto;
    }

    .hero-more {
      grid-area: more;
    }

    .hero-logo {
      width: 100%;
    }

    h2 {
      font-size: 2.1rem;
    }

    .hero-claim,
    .publishing-note {
      text-align: center;
    }

    .claim {
      font-size: 1.35rem;
    }

    .listen {
      padding: 1.25rem;
    }

    .content-section,
    .contact {
      padding: 5rem 2rem;
    }

    .content-grid,
    .contact__inner {
      align-items: start;
      gap: 3rem;
    }

    .content-grid {
      max-width: 48rem;
      justify-items: center;
      text-align: center;
    }

    .contact__inner {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: center;
    }

    .contact-link {
      justify-self: end;
    }
  }

  @media (min-width: 1040px) {
    .listen {
      padding: 1.25rem;
    }

    .platform-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .platform-link {
      min-height: 4.35rem;
    }
  }

  @media (max-width: 1039px) {
    .platform-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .platform-link {
      min-height: 4.2rem;
      align-items: center;
      justify-content: center;
      padding: 0.6rem;
    }

    .platform-link__icon {
      width: 3rem;
      height: 3rem;
    }

    .platform-link__icon img {
      width: 2.6rem;
      height: 2.6rem;
    }

    .platform-link__label {
      width: 1px;
      height: 1px;
      position: absolute;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .copy-icon {
      display: none;
    }
  }

  @media (max-width: 719px) {
    .intro__inner {
      grid-template-areas:
        "logo"
        "claim"
        "listen"
        "note"
        "more";
    }

    .hero-logo-block {
      grid-area: logo;
    }

    .hero-claim {
      grid-area: claim;
      text-align: center;
      justify-self: center;
      margin-inline: auto;
      margin-bottom: 1.5rem;
    }

    .listen {
      grid-area: listen;
    }

    .publishing-note {
      grid-area: note;
      text-align: center;
      justify-self: center;
      margin-inline: auto;
      margin-bottom: 1.5rem;
    }

    .hero-text {
      display: contents;
    }

    .hero-logo {
      width: min(100%, 21rem);
    }

    .listen {
      width: min(100%, 21rem);
      justify-self: center;
    }

    .hero-more {
      grid-area: more;
    }
  }

  @media (max-width: 420px) {
    .intro {
